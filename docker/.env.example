# ============================================================
# pladi — variables de entorno
# Copia este fichero a docker/.env y edita los valores.
#   cp docker/.env.example docker/.env
# ============================================================

# --- Sitio público (Caddy) ---
# En local: localhost (Caddy emite un certificado interno; ver README)
# En producción: tu dominio (Caddy obtiene Let's Encrypt automáticamente)
PLADI_SITE=localhost

# --- PostGIS ---
POSTGRES_USER=pladi
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=pladi
POSTGRES_PORT=5432

# --- MinIO ---
MINIO_ROOT_USER=pladi
MINIO_ROOT_PASSWORD=cambia_esta_clave
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Airflow ---
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=cambia_esta_clave
AIRFLOW_DB_PORT=5433
AIRFLOW_WS_PORT=8080
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=cambia_esta_clave

# --- FastAPI ---
FASTAPI_PORT=8000

# --- Jupyter ---
JUPYTER_TOKEN=cambia_esta_clave
JUPYTER_PORT=8888

---
import MainLayout from '../layouts/MainLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<MainLayout title="pladi · Dashboards">
  <Navbar />

  <div class="h-screen w-screen flex items-center justify-center bg-[#09090b] pt-11 pb-9">
    <div class="bg-zinc-900/80 backdrop-blur-xl border border-zinc-700/40 rounded-2xl p-12 text-center max-w-md">
      <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-blue-500/10 flex items-center justify-center">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="20" x2="18" y2="10" />
          <line x1="12" y1="20" x2="12" y2="4" />
          <line x1="6" y1="20" x2="6" y2="14" />
        </svg>
      </div>
      <h1 class="text-xl font-bold text-zinc-100 mb-2">Dashboards</h1>
      <p class="text-sm text-zinc-500 mb-4">
        Visualizaciones analíticas y KPIs de los recursos hídricos de las Illes Balears.
      </p>
      <span class="inline-block px-3 py-1 rounded-full text-[10px] font-medium bg-amber-500/10 text-amber-400 border border-amber-500/20">
        Próximamente
      </span>
    </div>
  </div>

  <Footer />
</MainLayout>

---
import MainLayout from '../layouts/MainLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<MainLayout title="pladi · Simulación">
  <Navbar />

  <div class="h-screen w-screen flex items-center justify-center bg-white dark:bg-[#09090b] pt-11 pb-9">
    <div class="bg-white/80 dark:bg-zinc-900/80 backdrop-blur-xl border border-zinc-300/40 dark:border-zinc-700/40 rounded-2xl p-8 sm:p-12 text-center max-w-md">
      <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-violet-500/10 flex items-center justify-center">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#a855f7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M10 2v7.31" />
          <path d="M14 9.3V1.99" />
          <path d="M8.5 2h7" />
          <path d="M14 9.3a6.5 6.5 0 1 1-4 0" />
          <path d="M5.52 16h12.96" />
        </svg>
      </div>
      <h1 class="text-xl font-bold text-zinc-900 dark:text-zinc-100 mb-2">Simulación</h1>
      <p class="text-sm text-zinc-400 dark:text-zinc-500 mb-4">
        Modelos predictivos y escenarios de gestión para los recursos hídricos subterráneos.
      </p>
      <span class="inline-block px-3 py-1 rounded-full text-[10px] font-medium bg-amber-500/10 text-amber-400 border border-amber-500/20">
        Próximamente
      </span>
    </div>
  </div>

  <Footer />
</MainLayout>
